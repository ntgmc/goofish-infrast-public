# Install as /etc/wireguard/wg0.conf with mode 0600 on the Seoul API/PostgreSQL host.
# Replace every placeholder; never commit real private keys.
[Interface]
Address = 10.66.0.1/30
ListenPort = 51820
PrivateKey = <SEOUL_PRIVATE_KEY>

[Peer]
PublicKey = <HANGZHOU_PUBLIC_KEY>
AllowedIPs = 10.66.0.2/32
