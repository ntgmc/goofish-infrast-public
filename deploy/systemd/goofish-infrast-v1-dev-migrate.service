[Unit]
Description=goofish-infrast-v1 dev database migration
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/goofish-infrast-v1-dev
ExecStart=/usr/bin/node /opt/goofish-infrast-v1-dev/server/dist/migrate.js
EnvironmentFile=/etc/goofish-infrast-v1/dev.env
Environment=NODE_ENV=production
Environment=APP_ROLE=api
Environment=ALLOW_DATABASE_MIGRATION=true
