# Store this as /etc/goofish-infrast-v1/backup.env with mode 0600. Do not commit values.
BACKUP_S3_REMOTE=s3-encrypted:goofish-production-backup
BACKUP_AGE_RECIPIENT=age1replace_with_the_offline_recovery_public_key
BACKUP_HEALTHCHECK_URL=https://healthcheck.example.com/replace-with-unguessable-token
RCLONE_CONFIG=/etc/goofish-infrast-v1/rclone.conf
# Optional: a distinct PostgreSQL backup user URL. Falls back to DATABASE_URL.
# BACKUP_DATABASE_URL=postgresql://goofish_backup:...@127.0.0.1:5432/goofish_infrast_v1
