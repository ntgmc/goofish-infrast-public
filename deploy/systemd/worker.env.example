# Store this file as /etc/goofish-infrast-v1-worker/worker.env with mode 0600.
# Never commit real credentials or WireGuard private keys.
DATABASE_URL=postgresql://goofish_worker:replace-me@10.66.0.1:5432/goofish_infrast_v1?uselibpqcompat=true&sslmode=require
SKLAND_CREDENTIAL_SECRET=replace-with-the-current-secret
SKLAND_CREDENTIAL_KEY_ID=active
# Keep the previous pair only during a controlled key-rotation window.
# SKLAND_CREDENTIAL_SECRET_PREVIOUS=replace-with-the-previous-secret
# SKLAND_CREDENTIAL_KEY_ID_PREVIOUS=previous

OPTIMIZE_WORKER_CONCURRENCY=1
OPTIMIZE_GLOBAL_WORKER_CONCURRENCY=3
OPTIMIZE_QUEUE_POLL_MS=2000
OPTIMIZE_JOB_LOCK_TTL_MS=60000
OPTIMIZE_JOB_HEARTBEAT_MS=15000
OPTIMIZE_JOB_MAX_ATTEMPTS=2
OPTIMIZE_JOB_HARD_TIMEOUT_MS=600000
OPTIMIZE_SHUTDOWN_GRACE_MS=900000
OPTIMIZE_RETRY_BASE_MS=2000
POSTGRES_POOL_MAX=3
