[Unit]
Description=goofish-infrast-v1 production backend (%i slot)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ntgmc
Group=ntgmc
WorkingDirectory=/opt/goofish-infrast-v1/slots/%i
ExecStart=/usr/bin/node /opt/goofish-infrast-v1/slots/%i/server/dist/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=75s
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
EnvironmentFile=/etc/goofish-infrast-v1/backend.env
EnvironmentFile=/etc/goofish-infrast-v1/%i.env

[Install]
WantedBy=multi-user.target
