{
  "name": "goofish-infrast-v1",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "generate:catalog": "node scripts/product-catalog.mjs",
    "check:catalog": "node scripts/product-catalog.mjs --check",
    "generate:data": "node scripts/generate-data.mjs",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "sync:operator-avatars": "node scripts/sync-operator-avatars.mjs",
    "predev": "npm run generate:data && npm run generate:changelog",
    "dev": "vite",
    "pretest": "npm run generate:data && npm run generate:changelog",
    "pretest:postgres": "npm run generate:data && npm run generate:changelog",
    "precheck:api": "npm run generate:data && npm run generate:changelog",
    "build:web": "tsc && vite build",
    "build:server": "npm run build:server:release",
    "build:server:public": "node scripts/build-server.mjs --scope public",
    "build:server:private": "node scripts/build-server.mjs --scope private",
    "build:server:release": "node scripts/build-server.mjs --scope release",
    "build:public": "npm run generate:data && npm run generate:changelog && npm run build:web && npm run build:server:public",
    "build:private": "npm run generate:data && npm run generate:changelog && npm run build:web && npm run build:server:release",
    "build": "npm run build:public",
    "test": "vitest run",
    "test:optimizer-benchmark-report": "node --test scripts/optimizer-benchmark-report.test.mjs",
    "test:generate-data": "node --test scripts/generate-data.test.mjs",
    "test:generate-changelog": "node --test scripts/generate-changelog.test.mjs",
    "test:release-artifact": "node --test scripts/release-artifact.test.mjs",
    "test:build-relevance": "node --test scripts/build-relevance-lib.test.mjs",
    "benchmark:optimizer:report": "node scripts/optimizer-benchmark-report.mjs",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:watch": "vitest",
    "check:copy": "node scripts/check-copy-architecture.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:architecture:public": "node scripts/check-architecture.mjs --scope public",
    "check:public-export": "node scripts/check-public-export.mjs",
    "check:dead-code": "knip --no-progress --no-config-hints && node scripts/check-dead-code.mjs",
    "check:dr": "node scripts/check-disaster-recovery.mjs",
    "check:deploy": "node scripts/check-production-deploy.mjs",
    "check:worker-link": "node scripts/check-worker-link.mjs",
    "check:build-relevance": "node scripts/check-build-relevance.mjs --check",
    "check:api": "node scripts/check-http-body-limit.mjs && node scripts/check-http-security-baseline.mjs && npm run check:public-http && node scripts/check-auth-security.mjs && node scripts/check-api-handlers.mjs && node scripts/check-skland-client.mjs && node scripts/check-skland-handler.mjs && node scripts/check-training-cost.mjs && node scripts/check-depot-profile.mjs && node scripts/check-workspace-history.mjs && node scripts/check-depot-value.mjs && node scripts/check-license-risk.mjs",
    "check:optimizer-dynamic-rules": "node scripts/check-optimizer-dynamic-rules.mjs",
    "check:efficiency-skill-refs": "node scripts/validate-efficiency-skill-refs.mjs",
    "check:public-http": "node scripts/check-public-http-smoke.mjs --self-test",
    "check:migration": "npm run build && node scripts/check-server-routes.mjs && node scripts/verify-migrated-data.mjs",
    "check:local": "npm run check:catalog && npm run build && npm run check:dead-code && npm run test:generate-changelog && npm test && npm run check:architecture && npm run check:copy && npm run check:dr && npm run check:deploy && npm run check:api && node scripts/check-server-routes.mjs",
    "migrate:database": "node --env-file=.env server/dist/migrate.js",
    "start:server": "npm run start:all",
    "start:api": "node --env-file=.env server/dist/index.js",
    "start:all": "node --env-file=.env server/dist/all.js",
    "start:worker": "node --env-file=.env server/dist/worker.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "knip": "^6.27.0",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
