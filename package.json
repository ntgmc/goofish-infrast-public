{
  "name": "goofish-infrast-v1",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "generate:data": "node scripts/generate-data.mjs",
    "predev": "npm run generate:data",
    "dev": "vite",
    "build:web": "tsc && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run generate:data && npm run build:web && npm run build:server",
    "check:deploy-relevance": "node scripts/netlify-ignore-build.mjs --check",
    "check:functions": "node scripts/check-optimize-function.mjs",
    "check:migration": "npm run build && node scripts/check-server-routes.mjs && node scripts/verify-migrated-data.mjs",
    "check:local": "npm run build && npm run check:functions && node scripts/check-server-routes.mjs",
    "start:server": "node server/dist/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@netlify/blobs": "^9.1.3",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
