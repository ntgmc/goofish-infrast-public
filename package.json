{
  "name": "goofish-infrast-v1",
  "private": true,
  "version": "2.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "generate:catalog": "node scripts/product-catalog.mjs",
    "check:catalog": "node scripts/product-catalog.mjs --check",
    "generate:data": "node scripts/generate-data.mjs",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "generate:release-sbom": "node scripts/generate-release-sbom.mjs",
    "check:types": "pnpm run check:types:web && pnpm run check:types:server",
    "check:types:web": "tsc --project tsconfig.json",
    "check:types:server": "tsc --project tsconfig.server.json",
    "backup:manifest": "node scripts/backup-manifest.mjs",
    "postgres:service-file": "node scripts/write-pg-service.mjs",
    "sync:operator-avatars": "node scripts/sync-operator-avatars.mjs",
    "sync:cultivation-icons": "node scripts/sync-cultivation-icons.mjs",
    "predev": "pnpm run generate:data && pnpm run generate:changelog",
    "dev": "vite",
    "pretest": "pnpm run generate:data && pnpm run generate:changelog",
    "pretest:postgres": "pnpm run generate:data && pnpm run generate:changelog",
    "precheck:api": "pnpm run generate:data && pnpm run generate:changelog",
    "build:web": "pnpm run check:types:web && vite build",
    "build:server": "pnpm run build:server:public",
    "build:server:public": "pnpm run check:types:server && node scripts/build-server.mjs --scope public",
    "build:public": "pnpm run generate:data && pnpm run generate:changelog && pnpm run generate:release-sbom && pnpm run build:web && pnpm run build:server:public",
    "build": "pnpm run build:public",
    "test": "vitest run",
    "test:generate-data": "node --test scripts/generate-data.test.mjs",
    "test:product-catalog": "node --test scripts/product-catalog-lib.test.mjs",
    "test:migration-verifier": "node --test scripts/migration-verifier-lib.test.mjs",
    "test:backup-contracts": "node --test scripts/backup-manifest.test.mjs && bash scripts/test-backup-postgres.sh && bash scripts/test-restore-postgres.sh",
    "test:generate-changelog": "node --test scripts/generate-changelog.test.mjs scripts/pr-changelog-analysis-lib.test.mjs",
    "test:release-artifact": "node --test scripts/release-artifact.test.mjs scripts/stage-release-artifact.test.mjs",
    "test:release-confirmation": "node --test scripts/confirm-production-release.test.mjs",
    "test:build-relevance": "node --test scripts/build-relevance-lib.test.mjs",
    "test:workflow-contracts": "node --test scripts/dependency-audit-workflow.test.mjs scripts/quality-workflow.test.mjs scripts/ci-validation-reuse.test.mjs",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:watch": "vitest",
    "check:copy": "node scripts/check-copy-architecture.mjs",
    "check:architecture": "node scripts/check-architecture.mjs --scope public",
    "check:architecture:public": "node scripts/check-architecture.mjs --scope public",
    "check:public-export": "node scripts/check-public-export.mjs",
    "check:dead-code": "knip --no-progress --no-config-hints && node scripts/check-dead-code.mjs",
    "check:build-relevance": "node scripts/check-build-relevance.mjs --check",
    "check:api": "node scripts/check-http-body-limit.mjs && node scripts/check-http-security-baseline.mjs && pnpm run check:public-http && node scripts/check-auth-security.mjs && node scripts/check-api-handlers.mjs && node scripts/check-skland-client.mjs && node scripts/check-skland-handler.mjs && node scripts/check-training-cost.mjs && node scripts/check-depot-profile.mjs && node scripts/check-workspace-history.mjs && node scripts/check-depot-value.mjs && node scripts/check-license-risk.mjs",
    "check:efficiency-skill-refs": "node scripts/validate-efficiency-skill-refs.mjs",
    "check:public-http": "node scripts/check-public-http-smoke.mjs --self-test",
    "check:release-runtime": "node scripts/check-release-runtime.mjs",
    "check:migration": "pnpm run build && node scripts/check-server-routes.mjs && node scripts/verify-migrated-data.mjs",
    "check:local": "pnpm run check:catalog && pnpm run test:product-catalog && pnpm run test:generate-data && pnpm run test:migration-verifier && pnpm run test:backup-contracts && pnpm run test:build-relevance && pnpm run check:build-relevance && pnpm run build && pnpm run check:dead-code && pnpm run test:generate-changelog && pnpm run test:release-artifact && pnpm run test:release-confirmation && pnpm run test:workflow-contracts && pnpm test && pnpm run check:architecture && pnpm run check:copy && pnpm run check:api && node scripts/check-server-routes.mjs",
    "migrate:database": "node --env-file=.env server/dist/migrate.js",
    "release:confirm-production": "node scripts/confirm-production-release.mjs",
    "start:server": "pnpm run build:server && pnpm run start:api",
    "start:api": "node --env-file=.env server/dist/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1123.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "openai": "^7.34.0",
    "pg": "^8.23.0",
    "pinyin-match": "^1.2.10",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "oxc-transform-react": "^0.152.0",
    "tailwindcss": "^4.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntgmc/goofish-infrast-public.git"
  },
  "bugs": {
    "url": "https://github.com/ntgmc/goofish-infrast-public/issues"
  },
  "homepage": "https://github.com/ntgmc/goofish-infrast-public#readme"
}
